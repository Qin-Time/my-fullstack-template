{
  "name": "my-fullstack-template",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm --prefix server run dev",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "install:all": "npm i && npm --prefix server i && npm --prefix web i",
    "clean": "rimraf node_modules server/node_modules web/node_modules",
    "clean:server": "rimraf server/node_modules",
    "clean:web": "rimraf web/node_modules"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "rimraf": "^6.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}